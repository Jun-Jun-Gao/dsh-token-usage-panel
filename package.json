{
  "name": "dsh-token-usage-panel",
  "version": "1.0.0",
  "description": "DSH plugin — a Token usage panel inside DeepSeek Harness settings: daily heatmap, 30-day trend, per-session breakdown and an optional cost estimate. / 在 DSH 设置里看每日 Token 消耗。",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "deepseek",
    "cordis-plugin",
    "token",
    "usage",
    "cost",
    "settings"
  ],
  "license": "MIT",
  "author": "Jun-Jun-Gao",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "check": "node scripts/check-manifest.mjs",
    "stats": "node lib/index.js"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jun-Jun-Gao/dsh-token-usage-panel.git"
  },
  "homepage": "https://github.com/Jun-Jun-Gao/dsh-token-usage-panel#readme",
  "bugs": {
    "url": "https://github.com/Jun-Jun-Gao/dsh-token-usage-panel/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
